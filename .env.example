# Optional enhanced insights and explicitly requested category suggestions.
# Server-only. Never commit a real key. The app never enables billing itself.
GEMINI_API_KEY=
# Set only after verifying Gemini Paid Services no-training terms apply to this
# project's processing AND the owner has approved any associated API costs.
# Exact value: gemini-paid-services-no-training. This is an operator attestation,
# not an automated billing/contract check. Free-tier confirmation does not enable AI.
AI_PRIVATE_PROCESSING_CONFIRMED=

# Optional. Enables cloud persistence + login instead of local-only IndexedDB.
# Get these from your Supabase project's Settings -> API page after running
# supabase/migrations/0001_init.sql in the SQL editor. Leave both unset to
# keep running fully local (no login, no cross-device sync).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Gmail alert sync. Server-only: never prefix these with NEXT_PUBLIC_.
# Apply migration 0013 first. See docs/gmail-setup.md for Google setup.
APP_ORIGIN=https://where-did-my-money-go-chi.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable across deploys.
GMAIL_TOKEN_KEY=
# Random bearer secret used by Vercel's daily cron.
CRON_SECRET=
