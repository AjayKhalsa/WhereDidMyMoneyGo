# Optional. Enables the low-confidence classifier fallback in the add-expense flow.
#
# The app is fully functional without this: the deterministic parser handles the
# entry path on its own, and /api/classify returns 501 when the key is absent,
# which the client treats as "no suggestion" and shows nothing.
#
# Get a key at https://aistudio.google.com/apikey and put it in .env.local
# (which is gitignored). Never commit a real key.
GEMINI_API_KEY=
# Server-only opt-in. Set only after confirming the key's project is Free tier
# with Cloud Billing disabled. This is an owner assertion, not a billing API check.
AI_FREE_TIER_CONFIRMED=

# Optional. Enables cloud persistence + login instead of local-only IndexedDB.
# Get these from your Supabase project's Settings -> API page after running
# supabase/migrations/0001_init.sql in the SQL editor. Leave both unset to
# keep running fully local (no login, no cross-device sync).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Gmail alert sync. Server-only: never prefix these with NEXT_PUBLIC_.
# Apply migration 0013 first. See docs/gmail-setup.md for Google setup.
APP_ORIGIN=https://where-did-my-money-go-chi.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable across deploys.
GMAIL_TOKEN_KEY=
# Random bearer secret used by Vercel's daily cron.
CRON_SECRET=
